{
  "//": "startercfg.json — environment-specific server config, kept OUT of source control.",
  "//note": "JSON has no comments; the // keys here are documentation — remove them, or use a",
  "//note2": "JSON5/lenient loader. These values OVERRIDE in-code defaults at boot. Config loading",
  "//note3": "is APP code (libnexaapp ships no config loader — see SKILL.md 'Where the library",
  "//note4": "boundary actually is'); adapt field names to your own loader.",

  "server": {
    "externalUrl": "http://192.168.1.137:8001",
    "//externalUrl": "THE most important field. Wally embeds this in every URI the server pushes, so it MUST be reachable from the wallet's network. Use your LAN IP for mobile testing, NOT localhost/127.0.0.1. Must match the machine's ACTUAL current LAN IP or the QR encodes an unreachable URL.",

    "listenPort": 8001,
    "//listenPort": "The port Ktor binds. Bind host should be 0.0.0.0 (in code) so the server is reachable from other devices, not just loopback.",

    "walletFile": "starterTestnetWallet",
    "//walletFile": "Name of the server's signing wallet (opened via libnexakotlin openWallet — see nexaWalletLifecycleAndChain). Do NOT commit the wallet .db file.",

    "trustedFullNode": null,
    "//trustedFullNode": "Optional host:port of a node you operate; null = use public seeders / SPV. If set, the server can restrict to it (wallet.blockchain.net.exclusiveNodes) and/or talk RPC (nexaRpcNodeClient)."
  },

  "rpc": {
    "//rpc": "Only if this server talks JSON-RPC to its own node (nexaRpcNodeClient). Omit otherwise. NEVER commit real credentials; these are full node control.",
    "url": "http://127.0.0.1:18332/",
    "username": "CHANGE_ME",
    "password": "CHANGE_ME"
  },

  "cors": {
    "//cors": "Allowed browser origins for production. Dev uses anyHost(); production should list exact origins. See corsProdVsDev.md.",
    "allowedOrigins": ["https://app.example.com"]
  }
}